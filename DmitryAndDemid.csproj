<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Desktop/Android run on .NET 10; the Switch homebrew build (mono-nx) runs the Mono interpreter on .NET 9,
         and a net10 assembly won't load there — so retarget to net9.0 when SwitchBuild is set. Driven by the same
         SwitchBuild property as the SWITCH constant (PropertyGroup below). -->
    <TargetFramework Condition=" '$(SwitchBuild)' == 'true' ">net9.0</TargetFramework>
    <TargetFramework Condition=" '$(SwitchBuild)' != 'true' ">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Shipped executable names: the game is aag2, the configurator is custom (Launcher/). -->
    <AssemblyName>aag2</AssemblyName>
    <RootNamespace>DmitryAndDemid</RootNamespace>

    <!-- Icon embedded into the Windows .exe apphost, aag2.exe (ignored on non-Windows builds). Generated from
         Assets/Textures/icon.png (Tools/magick auto-resize into a multi-size .ico); see also the Launcher, which
         points at the same file. The running window/taskbar icon is set separately in code
         (Runtime → SetWindowIcon("Assets/Textures/icon.png")), so both the file icon and the live icon match. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- linux-x64 is the desktop build; linux-arm64 targets the Tegra X1 (Nintendo Switch under L4T/switchroot
         Ubuntu, Jetson TX1, Shield TV). Publish the arm64 device build self-contained so the runtime ships with
         it (self-contained). See Tools/publish_tegra.sh. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Nintendo Switch homebrew build (mono-nx runtime + deko3d). Opt-in with `-p:SwitchBuild=true`. Defines
       the SWITCH constant that gates Rendering/Switch/**. This is a Phase-1 scaffold: it does NOT yet produce a
       runnable .nro — it needs a mono-nx native fork and an offline UAM shader step. See docs/switch-port.md.
       When a real device build exists, this is also where the desktop-only package references (Silk.NET,
       Raylib-cs, GtkSharp, Roslyn scripting) get stripped, since none of them can load under static P/Invoke. -->
  <PropertyGroup Condition=" '$(SwitchBuild)' == 'true' ">
    <DefineConstants>$(DefineConstants);SWITCH</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LuaCSharp" Version="0.5.5" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageReference Include="System.CodeDom" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GtkSharp" Version="3.24.24.95" />
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both of these are their own projects: the configurator (Launcher/) and the Android host (Android/). -->
    <Compile Remove="Launcher\**" />
    <Compile Remove="Android\**" />
    <!-- The unit-test project (Tests/) is also its own project; it references this one, so this one must not
         also compile the test sources (which pull in xUnit that the game doesn't reference). -->
    <Compile Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Assets\Shaders\loading.fs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Assets\Data\SpellCards\" />
    <Folder Include="Assets\Data\StagesJson\" />
  </ItemGroup>

  <!-- Compile the JSON stages (Assets/Data/StagesJson/*.json) into packed .sid at build time. Opt-in: it
       re-runs the just-built game headlessly (see the compile-stages arg in Program.cs). Enable with
       `dotnet build -p:CompileStages=true`. It runs in the output folder, reading the copied StagesJson and
       writing SpellCards there; failures never break the build (ContinueOnError). You can also compile from the
       Stage Editor's "Compile JSON to SID" menu item. -->
  <!-- Auto-incrementing build number. Bumps build_number.txt and generates DmitryAndDemid.BuildInfo.Number on
       every compile, so the loading screen can show WHICH build is actually running — this is how we catch a
       stale aag2.dll on the device's SD vs the one just built (a real source of confusion during the Switch port). -->
  <Target Name="IncrementBuildNumber" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildNumberFile>$(MSBuildProjectDirectory)/build_number.txt</BuildNumberFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="_BuildNumberLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <CurrentBuildNumber>@(_BuildNumberLines)</CurrentBuildNumber>
      <CurrentBuildNumber Condition="'$(CurrentBuildNumber)' == ''">0</CurrentBuildNumber>
      <NextBuildNumber>$([MSBuild]::Add($(CurrentBuildNumber), 1))</NextBuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(NextBuildNumber)" Overwrite="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Overwrite="true"
      Lines="namespace DmitryAndDemid { public static class BuildInfo { public const int Number = $(NextBuildNumber)%3B } }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CompileStagesFromJson" AfterTargets="Build" Condition="'$(CompileStages)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetDir)aag2.dll&quot; --compile-stages"
          WorkingDirectory="$(TargetDir)" ContinueOnError="true" />
  </Target>

</Project>
