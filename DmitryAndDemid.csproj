<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Shipped executable names: the game is aag2, the configurator is custom (Launcher/). -->
    <AssemblyName>aag2</AssemblyName>
    <RootNamespace>DmitryAndDemid</RootNamespace>

    <!-- Icon embedded into the Windows .exe (ignored on non-Windows builds). Generated from
         Assets/Textures/game_logo.png; see also the Launcher, which points at the same file. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- linux-x64 is the desktop build; linux-arm64 targets the Tegra X1 (Nintendo Switch under L4T/switchroot
         Ubuntu, Jetson TX1, Shield TV). Publish the arm64 device build self-contained so the runtime ships with
         it (self-contained). See Tools/publish_tegra.sh. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LuaCSharp" Version="0.5.5" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageReference Include="System.CodeDom" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GtkSharp" Version="3.24.24.95" />
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both of these are their own projects: the configurator (Launcher/) and the Android host (Android/). -->
    <Compile Remove="Launcher\**" />
    <Compile Remove="Android\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Assets\Shaders\loading.fs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Assets\Data\SpellCards\" />
    <Folder Include="Assets\Data\StagesJson\" />
  </ItemGroup>

  <!-- Compile the JSON stages (Assets/Data/StagesJson/*.json) into packed .sid at build time. Opt-in: it
       re-runs the just-built game headlessly (see the compile-stages arg in Program.cs). Enable with
       `dotnet build -p:CompileStages=true`. It runs in the output folder, reading the copied StagesJson and
       writing SpellCards there; failures never break the build (ContinueOnError). You can also compile from the
       Stage Editor's "Compile JSON to SID" menu item. -->
  <Target Name="CompileStagesFromJson" AfterTargets="Build" Condition="'$(CompileStages)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetDir)aag2.dll&quot; --compile-stages"
          WorkingDirectory="$(TargetDir)" ContinueOnError="true" />
  </Target>

</Project>
