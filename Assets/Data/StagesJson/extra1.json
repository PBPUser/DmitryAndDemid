    {
      "Header": [
        2,
        0,
        300,
        0,
        0,
        0,
        0,
        0
      ],
      "Dialogs": [
        {
          "Header": [
            0,
            0,
            0,
            0
          ],
          "CharacterTexture": "demid_dialog_arts.png",
          "Text": "Дальше не пройдёшь. Здесь я записываю.",
          "Emotion": "💻",
          "IsPlayerDialog": false,
          "SwitchReaction": false,
          "SwitchMusic": false,
          "ShowBossName": true,
          "Unskippable": false
        },
        {
          "Header": [
            0,
            0,
            0,
            0
          ],
          "CharacterTexture": "demid_dialog_arts.png",
          "Text": "Дмитрий выпускал — я записывал.\nТри года, без единого пропуска.",
          "Emotion": "🖥",
          "IsPlayerDialog": false,
          "SwitchReaction": false,
          "SwitchMusic": false,
          "ShowBossName": false,
          "Unskippable": false
        },
        {
          "Header": [
            0,
            0,
            0,
            0
          ],
          "CharacterTexture": "",
          "Text": "Ты всё это снимал и не помог ему?",
          "Emotion": "❓",
          "IsPlayerDialog": true,
          "SwitchReaction": false,
          "SwitchMusic": false,
          "ShowBossName": false,
          "Unskippable": false
        },
        {
          "Header": [
            0,
            0,
            0,
            0
          ],
          "CharacterTexture": "demid_dialog_arts.png",
          "Text": "Я не участник. Я архив.",
          "Emotion": "🖱",
          "IsPlayerDialog": false,
          "SwitchReaction": false,
          "SwitchMusic": false,
          "ShowBossName": false,
          "Unskippable": false
        },
        {
          "Header": [
            0,
            0,
            0,
            0
          ],
          "CharacterTexture": "demid_dialog_arts.png",
          "Text": "Но ты стёр последний дубль.\nПридётся выйти из режима просмотра.",
          "Emotion": "⚡",
          "IsPlayerDialog": false,
          "SwitchReaction": false,
          "SwitchMusic": false,
          "ShowBossName": false,
          "Unskippable": false
        },
        {
          "Header": [
            0,
            0,
            0,
            0
          ],
          "CharacterTexture": "",
          "Text": "Выходи.",
          "Emotion": "✋",
          "IsPlayerDialog": true,
          "SwitchReaction": false,
          "SwitchMusic": false,
          "ShowBossName": false,
          "Unskippable": false
        },
        {
          "Header": [
            0,
            0,
            0,
            0
          ],
          "CharacterTexture": "demid_dialog_arts.png",
          "Text": "Пишу с этого момента.\nПостарайся не умереть в первом же дубле.",
          "Emotion": "🗘",
          "IsPlayerDialog": false,
          "SwitchReaction": false,
          "SwitchMusic": false,
          "ShowBossName": false,
          "Unskippable": false
        }
      ],
