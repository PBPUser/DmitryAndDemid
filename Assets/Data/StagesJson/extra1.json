      "Id": "demid#extra#window",
      "SpellcardTitle": "spell.card.22",
      "BossName": "Демид",
      "CreateScript": "demid#extra#window#create",
      "UpdateScript": "",
      "SpellcardTexture": "demid-spell-background.png",
      "SpellcardShader": "spellcard_nikitos",
      "TimeoutCard": false,
      "BossInvincible": false,
      "HasDialogs": false,
      "UseUpdateScript": false,
      "UseCreateScript": true,
