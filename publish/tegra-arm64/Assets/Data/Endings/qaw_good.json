{
  "IsBad": false,
  "AddTexts": [
    {"ID": 1, "Text": "Фейдер вниз, но пульс не гас,"},
    {"ID": 2, "Text": "В мониторах дышит бас."},
    {"ID": 3, "Text": "Старый голос, новый слой,"},
    {"ID": 4, "Text": "Звук уходит под покой."},
    {"ID": 6, "Text": "Табла ритм в сеть увела,"},
    {"ID": 7, "Text": "Цифра древность обрела."},
    {"ID": 8, "Text": "В панораме свет и тень,"},
    {"ID": 9, "Text": "Звук родился в этот день."},
    {"ID": 12, "Text": "Мастер-шина приняла,"},
    {"ID": 13, "Text": "Суть, что в сердце там жила."},
    {"ID": 14, "Text": "Компрессор сжал дыхание,"},
    {"ID": 15, "Text": "В тихом, мудром ожидании."},
    {"ID": 17, "Text": "Рендер ждёт, в окне рассвет,"},
    {"ID": 18, "Text": "В наушниках — ответ."},
    {"ID": 19, "Text": "Не консоль, а древний храм,"},
    {"ID": 20, "Text": "Звук отдан по всем волнам."},
    {"ID": 22, "Text": "Суфий голос в эфир,"},
    {"ID": 23, "Text": "Облетел весь этот мир."},
    {"ID": 24, "Text": "Сэмпл сердца, бас и свет,"},
    {"ID": 25, "Text": "В каждом кадре — завет."},
    {"ID": 28, "Text": "Файл сохранён, путь ясен,"},
    {"ID": 29, "Text": "Мир звучит, он прекрасен."},
    {"ID": 30, "Text": "Не кнопка, а дух жив,"},
    {"ID": 31, "Text": "В каждом бите — призыв."},
    {"ID": 33, "Text": "Уходи, звук, в народ,"},
    {"ID": 34, "Text": "Где поёт его восход."},
    {"ID": 35, "Text": "Не формат, а соль и свет,"},
    {"ID": 36, "Text": "В нём звучит души завет."},
    {"ID": 38, "Text": "Студия молчит, пуста,"},
    {"ID": 39, "Text": "Но в эфире — красота."},
    {"ID": 40, "Text": "Дышит кавали в сердцах,"},
    {"ID": 41, "Text": "Свет застыл на проводах."}
  ],
