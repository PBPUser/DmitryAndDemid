<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless unit tests for the game. The philosophy: the game owns a window and a GL/Vulkan context, none of
    which exist in a test run, so tests NEVER touch the GPU. They drive the game's pure, headless seams instead
    — chiefly Assets.Source (Utils/Assets.cs), the same abstraction that lets the game read content on Android
    and Switch. See Tests/README.md.

    Run with:  dotnet test Tests/DmitryAndDemid.Tests.csproj
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A test assembly is a library loaded by the test host, not an app; the game project it references is an
         Exe, but that only contributes its types here, not its entry point. -->
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- linux-x64 is the desktop dev/CI target; the game project multi-RIDs, the tests do not need to. -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the game to get at its types (Utils.Assets, Utils.TextureManifest, …). The game's Content
         (Assets/**) is NOT copied into the test output by a ProjectReference — TestEnvironment locates the real
         repo Assets/ folder at runtime and points Assets.Source at it, so tests read exactly what ships. -->
    <ProjectReference Include="..\DmitryAndDemid.csproj" />
  </ItemGroup>

</Project>
